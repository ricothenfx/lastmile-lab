# Template sekret lastmile-lab — salin ke deploy/.env dan isi nilai asli.
# deploy/.env di-gitignore; tidak ada secret yang pernah masuk git.

LASTMILE_PG_PASSWORD=change-me-strong

# IP gateway jaringan docker milik Caddy (turnaround-prod_default) — dipakai sbg
# bind host port untuk service yang di-proxy Caddy (ws/api gateway).
# Verifikasi: docker network inspect turnaround-prod_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
LASTMILE_BIND_IP=127.0.0.1

# Tag image GHCR (default latest)
# LASTMILE_IMAGE_TAG=latest
# LASTMILE_GRAFANA_ADMIN_PASSWORD=change-me   # bila grafana diaktifkan (Fase 2+)
