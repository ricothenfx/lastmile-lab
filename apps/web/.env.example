# Frontend env — semua endpoint via env var, TIDAK pernah di-hardcode.
# Vercel: set di Project Settings → Environment Variables.

# WebSocket gateway (produksi):
NEXT_PUBLIC_WS_URL=wss://ws.lastmile-lab.ricothen.com/ws
NEXT_PUBLIC_API_URL=https://api.lastmile-lab.ricothen.com

# Local dev (backend via docker compose di VPS / mesin lokal):
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3012/ws
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3010
